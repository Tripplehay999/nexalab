# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (set in Vercel → Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# Bot protection for public forms + sign-in (optional; Cloudflare Turnstile).
# If you set the site key, also enable Supabase Auth → Attack Protection → Captcha (Turnstile) with the same secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional salt for hashing IPs in rate limits (defaults to part of the service key)
RATE_LIMIT_SALT=
